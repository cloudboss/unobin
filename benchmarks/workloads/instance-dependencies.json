  "samples": 10,
  "benchtime": "2s",
  "cpus": [
    1,
    4
  ],
  "setup": "Parse fixed UB leaf bodies and create declaration scopes and keyed steps outside timing. Measure PlanGraph including address parsing, pair-key analysis, dependency construction, and sorted graph output. The nested cases contain 200 leaf steps at iteration depths 1, 3, and 6, including each leaf's own key. Assert final addresses, exact dependency lists, and fixed step/edge counts outside timing. Retain the existing checked-factory planning and independent/chain/fan scheduler benchmarks.",
  "cache-policy": "Symmetric warm Go build cache and one 1x benchmark warmup. Default GC, no persistent instance graph cache, no unrelated CPU-intensive work during collection.",
  "primary-unit": "sec/op",
  "primary-direction": "lower",
  "tests": [
    [
      "go",
      "test",
      "-count=1",
      "./pkg/runtime",
      "./pkg/sdk/state",
      "./internal/ubtest"
    ],
    [
      "go",
      "test",
      "-count=1",
      "-run",
      "^TestCompiledCases$/^ub-composite-foreach$",
      "./tests/e2e"
    ]
  ]
}
