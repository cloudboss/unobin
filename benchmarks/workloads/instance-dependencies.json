{
  "work-package": "instance-dependencies",
  "description": "Sparse paired and nested instance dependencies, Cartesian output, and existing planning and scheduler cases",
  "kind": "micro",
  "fixtures": [
    "pkg/runtime/apply_graph_benchmark_test.go",
    "pkg/runtime/testdata/ub/apply-graph",
    "pkg/runtime/dag_test.go",
    "pkg/runtime/nodes_test.go",
    "pkg/runtime/plan_test.go",
    "pkg/runtime/apply_schedule_test.go"
  ],
  "parameters": {
    "paired-counts": "100,250,500,1000,2000",
    "nested-depths": "1,3,6",
    "nested-pairs": "100",
    "cartesian-counts": "10,25,50,100",
    "planning-nodes": "300",
    "scheduler-steps": "1000",
    "scheduler-parallelism": "32",
    "step-bindings": "omitted; dependency construction only"
  },
  "packages": [
    "./pkg/runtime"
  ],
  "benchmark": "^(BenchmarkPlanGraphPairedInstances|BenchmarkPlanGraphNestedInstances|BenchmarkPlanGraphCartesianInstances|BenchmarkPlanLargeAlreadyCheckedFactory|BenchmarkApplySchedulerLargeIndependentPlan)$",
  "cases": [
    {
      "package": "github.com/cloudboss/unobin/pkg/runtime",
      "name": "BenchmarkPlanGraphPairedInstances/pairs=100",
      "units": [
        "sec/op",
        "B/op",
        "allocs/op",
        "steps",
        "edges"
      ],
      "fixed": {
        "steps": 200,
        "edges": 100
      }
    },
    {
      "package": "github.com/cloudboss/unobin/pkg/runtime",
