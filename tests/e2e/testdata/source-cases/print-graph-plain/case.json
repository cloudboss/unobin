{
  "name": "print-graph-plain",
  "rootPath": "graph-plain",
  "executor": "root",
  "cliVersion": "v0.1.0",
  "remotes": [
    {
      "key": "github.com/cloudboss/unobin//pkg/libraries/core@v0.1.0",
      "path": "remotes/core",
      "commit": "c"
    }
  ],
  "commands": [
    {
      "name": "print-graph",
      "args": ["print-graph", "-p", "factory.ub"],
      "stdout": "want/print-graph.stdout"
    },
    {
      "name": "print-graph-json",
      "args": ["print-graph", "-p", "factory.ub", "--format", "json"],
      "stdout": "want/print-graph-json.stdout",
      "normalize": "json"
    },
    {
      "name": "print-graph-unobin",
      "args": ["print-graph", "-p", "factory.ub", "--format", "unobin"],
      "stdout": "want/print-graph-unobin.stdout"
    }
  ]
}
