{
  "name": "generate-factory-dev",
  "rootPath": ".",
  "executor": "root",
  "commands": [
    {
      "name": "generate-factory",
      "args": ["generate", "factory", "-o", "generated"],
      "stdout": "want/stdout",
      "stderr": "want/stderr"
    },
    {
      "name": "generate-factory-json-unchanged",
      "args": ["generate", "factory", "-o", "generated", "--force", "--format", "json"],
      "stdout": "want/generate-json-unchanged.stdout",
      "normalize": "json"
    },
    {
      "name": "generate-factory-unobin-unchanged",
      "args": ["generate", "factory", "-o", "generated", "--force", "--format", "unobin"],
      "stdout": "want/generate-unobin-unchanged.stdout"
    }
  ],
  "files": [
    { "path": "generated/factory.ub", "want": "want/factory.ub" },
    { "path": "generated/project.ub", "want": "want/project.ub" }
  ]
}
