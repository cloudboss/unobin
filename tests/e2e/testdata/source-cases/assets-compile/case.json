{
  "name": "assets-compile",
  "rootPath": "factory/app",
  "executor": "root",
  "cliVersion": "v0.1.0",
  "commands": [
    {
      "name": "check",
      "args": ["check", "-p", "factory.ub"],
      "stdout": "want/check.stdout"
    },
    {
      "name": "print-graph",
      "args": ["print-graph", "-p", "factory.ub"]
    },
    {
      "name": "compile",
      "args": ["compile", "-p", "factory.ub", "-o", "build"]
    },
    {
      "name": "compile-json",
      "args": ["compile", "-p", "factory.ub", "-o", "build", "--format", "json"],
      "stdout": "want/compile-json.stdout",
      "normalize": "json"
    },
    {
      "name": "compile-stdout",
      "args": ["compile", "-p", "factory.ub", "-o", "-"],
      "stderr": "want/compile-stdout.stderr",
      "exitCode": 1
    },
    {
      "name": "missing-source",
      "args": ["compile", "-p", "cases/missing-source/factory.ub", "-o", "build-missing"],
      "stderr": "want/missing-source.stderr",
      "exitCode": 1
    },
    {
      "name": "bracket-file",
      "args": ["compile", "-p", "cases/bracket-file/factory.ub", "-o", "build-bracket"],
      "stderr": "want/bracket-file.stderr",
      "exitCode": 1
    },
    {
      "name": "missing-entry",
      "args": ["compile", "-p", "cases/missing-entry/factory.ub", "-o", "build-entry"],
      "stderr": "want/missing-entry.stderr",
      "exitCode": 1
    },
    {
      "name": "source-output-overlap",
      "args": [
        "compile",
        "-p", "cases/overlap/factory.ub",
        "-o", "cases/overlap/overlap-source/build"
      ],
      "stderr": "want/source-output-overlap.stderr",
      "exitCode": 1
    }
  ],
  "files": [
    {
      "path": "factory/app/build/main.go",
      "want": "want/main.go"
    }
  ]
}
