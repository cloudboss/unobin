{
  "name": "generate-factory-release",
  "rootPath": ".",
  "executor": "root",
  "cliVersion": "v0.3.0",
  "commands": [
    {
      "name": "generate-factory-json",
      "args": ["generate", "factory", "-o", "generated", "--format", "json"],
      "stdout": "want/generate-json.stdout",
      "normalize": "json"
    },
    {
      "name": "generate-factory",
      "args": ["generate", "factory", "-o", "generated", "--force"],
      "stdout": "want/stdout",
      "stderr": "want/stderr"
    }
  ],
  "files": [
    { "path": "generated/factory.ub", "want": "want/factory.ub" },
    { "path": "generated/project.ub", "want": "want/project.ub" }
  ]
}
