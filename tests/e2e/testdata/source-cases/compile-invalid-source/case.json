{
  "name": "compile-invalid-source",
  "rootPath": "demo-factory",
  "executor": "root",
  "cliVersion": "v0.1.0",
  "commands": [
    {
      "name": "compile",
      "args": ["compile", "-p", "factory.ub", "-o", "-"],
      "stderr": "want/compile.stderr",
      "exitCode": 1
    },
    {
      "name": "compile-json",
      "args": ["compile", "-p", "factory.ub", "-o", "build", "--format", "json"],
      "stdout": "want/compile-json.stdout",
      "normalize": "json",
      "exitCode": 1
    }
  ]
}
