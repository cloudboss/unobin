{
  "name": "deps-list",
  "rootPath": "root",
  "executor": "root",
  "commands": [
    {
      "name": "deps-list",
      "args": ["deps", "list", "-p", "factory.ub"],
      "stdout": "want/deps-list.stdout"
    },
    {
      "name": "deps-list-json",
      "args": ["deps", "list", "-p", "factory.ub", "--format", "json"],
      "stdout": "want/deps-list-json.stdout",
      "normalize": "json"
    },
    {
      "name": "deps-list-unobin",
      "args": ["deps", "list", "-p", "factory.ub", "--format", "unobin"],
      "stdout": "want/deps-list-unobin.stdout"
    }
  ]
}
