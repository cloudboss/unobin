{
  "name": "compile-write-output",
  "rootPath": "demo-factory",
  "executor": "root",
  "cliVersion": "v0.1.0",
  "remotes": [
    {
      "key": "github.com/cloudboss/unobin/pkg/libraries/core@v0.1.0",
      "path": "remotes/core",
      "commit": "c"
    },
    {
      "key": "github.com/cloudboss/unobin/pkg/libraries/core@c",
      "path": "remotes/core",
      "commit": "c"
    }
  ],
  "commands": [
    {
      "name": "compile",
      "args": ["compile", "-p", "factory.ub", "-o", "build"]
    },
    {
      "name": "compile-json-unchanged",
      "args": ["compile", "-p", "factory.ub", "-o", "build", "--format", "json"],
      "stdout": "want/compile-json-unchanged.stdout",
      "normalize": "json"
    },
    {
      "name": "compile-unobin-unchanged",
      "args": ["compile", "-p", "factory.ub", "-o", "build", "--format", "unobin"],
      "stdout": "want/compile-unobin-unchanged.stdout"
    },
    {
      "name": "compile-json-partial",
      "args": ["compile", "-p", "factory.ub", "-o", "blocked", "--format", "json"],
      "stdout": "want/compile-json-partial.stdout",
      "normalize": "json",
      "exitCode": 1
    },
    {
      "name": "compile-json-stdout-conflict",
      "args": ["compile", "-p", "factory.ub", "-o", "-", "--format", "json"],
      "stdout": "want/compile-json-stdout-conflict.stdout",
      "normalize": "json",
      "exitCode": 1
    }
  ],
  "files": [
    { "path": "demo-factory/build/main.go", "want": "want/main.go" },
    { "path": "demo-factory/build/go.mod", "want": "want/go.mod" }
  ]
}
