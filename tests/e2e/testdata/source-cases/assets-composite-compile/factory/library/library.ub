payload: data-source {
  assets: {
    content: './payload.bin'
  }

  outputs: {
    digest: {
      value: asset.content.content-sha256
    }
  }
}

sibling: data-source {
  assets: {
    sibling: './sibling.txt'
  }

  outputs: {
    digest: {
      value: asset.sibling.content-sha256
    }
  }
}
