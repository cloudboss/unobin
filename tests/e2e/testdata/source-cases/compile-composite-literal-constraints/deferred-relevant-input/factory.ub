factory: {
  inputs: {
    e2e-config: {
      type: library-config('example.com/unobin/e2elib')
      default: {
        base-dir:       '.'
        event-log-path: 'events.ndjson'
        nested:         { label: 'nested' }
      }
    }
    min-capacity: { type: number }
  }

  imports: {
    e2e:     'example.com/unobin/e2elib'
    control: '../libraries/control'
  }

  library-configs: { e2e: input.e2e-config }

  resources: {
    control: control.control {
      database:   { min-capacity: input.min-capacity, max-capacity: 4.0 }
      e2e-config: input.e2e-config
    }
  }
}
