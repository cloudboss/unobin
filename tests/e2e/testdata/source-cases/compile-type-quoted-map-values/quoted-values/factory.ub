factory: {
  inputs: {
    database: {
      type: object({
        port: integer
        name: string
      })
    }
    e2e-config: {
      type: library-config('example.com/unobin/e2elib')
      default: {
        base-dir:       '.'
        event-log-path: 'events.ndjson'
        nested:         { label: 'nested' }
      }
    }
  }

  imports: {
    app: './libraries/app'
    e2e: 'example.com/unobin/e2elib'
  }

  library-configs: { e2e: input.e2e-config }

  resources: {
    api: app.api {
      e2e-config: input.e2e-config
      environment: {
        variables: {
          'PORT':     input.database.port
          'DATABASE': input.database
        }
      }
    }
  }
}
