{
  "name": "conditional-plan",
  "factoryPath": "src",
  "libraryPath": "example.com/unobin/e2e/conditional-plan",
  "build": true,
  "commands": [
    {
      "name": "plan-create",
      "args": ["plan", "--ascii", "--parallelism", "1", "-c", "stacks/create/dev.ub", "-o", "create.ubp"],
      "stdout": "want/plan-create.stdout",
      "stderr": "want/plan-create.stderr"
    },
    {
      "name": "apply-create",
      "args": ["apply", "--format", "json", "create.ubp"],
      "stdout": "want/apply-create.stdout",
      "normalize": "json"
    },
    {
      "name": "plan-update",
      "args": ["plan", "--ascii", "--parallelism", "1", "-c", "stacks/update/dev.ub", "-o", "update.ubp"],
      "stdout": "want/plan-update.stdout",
      "stderr": "want/plan-update.stderr"
    },
    {
      "name": "apply-update",
      "args": ["apply", "--format", "json", "update.ubp"],
      "stdout": "want/apply-update.stdout",
      "normalize": "json"
    },
    {
      "name": "output",
      "args": ["output", "--format", "json", "-c", "stacks/update/dev.ub"],
      "stdout": "want/output.stdout",
      "normalize": "json"
    },
    {
      "name": "plan-destroy",
      "args": ["plan", "--ascii", "--parallelism", "1", "--destroy", "-c", "stacks/update/dev.ub", "-o", "destroy.ubp"],
      "stdout": "want/plan-destroy.stdout",
      "stderr": "want/plan-destroy.stderr"
    },
    {
      "name": "apply-destroy",
      "args": ["apply", "--format", "json", "destroy.ubp"],
      "stdout": "want/apply-destroy.stdout",
      "normalize": "json"
    }
  ],
  "files": [{ "path": "events.ndjson", "want": "want/events.ndjson" }],
  "stateSummary": "want/state-summary.json"
}
