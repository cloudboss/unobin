{
  "name": "validate-stacks",
  "factoryPath": "src",
  "libraryPath": "example.com/unobin/e2e/validate-stacks",
  "build": true,
  "commands": [
    {
      "name": "validate-source",
      "args": ["validate", "--allow-version-mismatch"],
      "stdout": "want/validate-source.stdout",
      "stderr": "want/validate-source.stderr"
    },
    {
      "name": "validate-good-env-key",
      "args": ["validate", "--allow-version-mismatch", "-c", "stacks/good-env-key.ub"],
      "stdout": "want/validate-good-env-key.stdout",
      "stderr": "want/validate-good-env-key.stderr",
      "skipPin": true
    },
    {
      "name": "validate-good-gcs",
      "args": ["validate", "--allow-version-mismatch", "-c", "stacks/good-gcs.ub"],
      "stdout": "want/validate-good-env-key.stdout",
      "stderr": "want/validate-good-env-key.stderr",
      "skipPin": true
    },
    {
      "name": "validate-good-gcp-kms",
      "args": ["validate", "--allow-version-mismatch", "-c", "stacks/good-gcp-kms.ub"],
      "stdout": "want/validate-good-env-key.stdout",
      "stderr": "want/validate-good-env-key.stderr",
      "skipPin": true
    },
    {
      "name": "validate-bad-gcs-missing-bucket",
      "args": ["validate", "--allow-version-mismatch", "-c", "stacks/bad-gcs-missing-bucket.ub"],
      "stderr": "want/validate-bad-gcs-missing-bucket.stderr",
      "exitCode": 1,
      "skipPin": true
    },
    {
      "name": "validate-bad-gcp-kms-missing-key-id",
      "args": ["validate", "--allow-version-mismatch", "-c", "stacks/bad-gcp-kms-missing-key-id.ub"],
      "stderr": "want/validate-bad-gcp-kms-missing-key-id.stderr",
      "exitCode": 1,
      "skipPin": true
    },
    {
      "name": "validate-bad-gcs-endpoint-preferences",
      "args": ["validate", "--allow-version-mismatch", "-c", "stacks/bad-gcs-endpoint-preferences.ub"],
      "stderr": "want/validate-bad-gcs-endpoint-preferences.stderr",
      "exitCode": 1,
      "skipPin": true
    },
    {
      "name": "validate-bad-syntax",
      "args": ["validate", "--allow-version-mismatch", "-c", "stacks/bad-syntax.ub"],
      "stderr": "want/validate-bad-syntax.stderr",
      "exitCode": 1,
      "skipPin": true
    },
    {
      "name": "validate-bad-syntax-json",
      "args": [
        "validate",
        "--allow-version-mismatch",
        "-c",
        "stacks/bad-syntax.ub",
        "--format",
        "json"
      ],
      "stdout": "want/validate-bad-syntax-json.stdout",
      "normalize": "json",
      "exitCode": 1,
      "skipPin": true
    },
    {
      "name": "validate-missing-json",
      "args": ["validate", "-c", "stacks/missing.ub", "--format", "json"],
      "stdout": "want/validate-missing-json.stdout",
      "normalize": "json",
      "exitCode": 1,
      "skipPin": true
    },
    {
      "name": "validate-unwrapped-stack",
      "args": ["validate", "--allow-version-mismatch", "-c", "stacks/unwrapped.ub"],
      "stderr": "want/validate-unwrapped-stack.stderr",
      "exitCode": 1,
      "skipPin": true
    },
    {
      "name": "validate-dotted-backend",
      "args": ["validate", "--allow-version-mismatch", "-c", "stacks/dotted-backend.ub"],
      "stderr": "want/validate-dotted-backend.stderr",
      "exitCode": 1,
      "skipPin": true
    },
    {
      "name": "validate-encryption-inside-state",
      "args": ["validate", "--allow-version-mismatch", "-c", "stacks/encryption-inside-state.ub"],
      "stderr": "want/validate-encryption-inside-state.stderr",
      "exitCode": 1,
      "skipPin": true
    },
    {
      "name": "validate-unknown-backend",
      "args": ["validate", "--allow-version-mismatch", "-c", "stacks/unknown-backend.ub"],
      "stderr": "want/validate-unknown-backend.stderr",
      "exitCode": 1,
      "skipPin": true
    },
    {
      "name": "validate-bad-backend-body",
      "args": ["validate", "--allow-version-mismatch", "-c", "stacks/bad-backend-body.ub"],
      "stderr": "want/validate-bad-backend-body.stderr",
      "exitCode": 1,
      "skipPin": true
    },
    {
      "name": "validate-unknown-encrypter",
      "args": ["validate", "--allow-version-mismatch", "-c", "stacks/unknown-encrypter.ub"],
      "stderr": "want/validate-unknown-encrypter.stderr",
      "exitCode": 1,
      "skipPin": true
    }
  ],
  "deterministic": true
}
