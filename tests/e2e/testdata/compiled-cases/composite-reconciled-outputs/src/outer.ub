outer: resource {
  inputs: {
    path: { type: string }
    e2e-config: { type: library-config('example.com/unobin/e2elib') }
  }
  imports: { lib: './libraries' }
  resources: {
    child: lib.inner { path: input.path, e2e-config: input.e2e-config }
  }
  locals: { content: resource.child.content }
  outputs: { content: { value: local.content } }
}
