region: action {
  inputs: {
    aws: { type: library-config('example.com/aws//config') }
  }

  imports: {
    service: 'example.com/aws//service'
  }

  library-configs: {
    service: input.aws
  }

  constraints: [
    {
      kind:    predicate
      when:    true
      require: input.aws.region != ''
      message: 'region is required'
    },
  ]

  actions: {
    inner: service.region {}
  }

  outputs: {
    region: { value: action.inner.region }
  }
}
