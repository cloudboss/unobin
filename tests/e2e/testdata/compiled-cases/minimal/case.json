{
  "name": "minimal",
  "factoryPath": "src",
  "libraryPath": "example.com/unobin/e2e/minimal",
  "build": true,
  "commands": [
    {
      "name": "version",
      "args": ["version"],
      "stdout": "want/version.stdout",
      "stderr": "want/version.stderr"
    },
    {
      "name": "version-help",
      "args": ["version", "--format", "json", "--help"],
      "stdout": "want/version-help.stdout"
    },
    {
      "name": "version-json",
      "args": ["version", "--format", "json"],
      "stdout": "want/version-json.stdout",
      "normalize": "json"
    },
    {
      "name": "version-unobin",
      "args": ["version", "--format", "unobin"],
      "stdout": "want/version-unobin.stdout"
    },
    {
      "name": "version-unknown-format",
      "args": ["version", "--format", "yaml"],
      "stderr": "want/version-unknown-format.stderr",
      "exitCode": 1
    },
    {
      "name": "version-wrong-args",
      "args": ["version", "extra", "--format", "json"],
      "stderr": "want/version-wrong-args.stderr",
      "exitCode": 1
    },
    {
      "name": "pin-json",
      "args": ["pin", "-c", "stacks/dev.ub", "--format", "json"],
      "stdout": "want/pin-json.stdout",
      "normalize": "json"
    },
    {
      "name": "pin-unobin-unchanged",
      "args": ["pin", "-c", "stacks/dev.ub", "--format", "unobin"],
      "stdout": "want/pin-unobin-unchanged.stdout"
    },
    {
      "name": "validate",
      "args": ["validate", "-c", "stacks/dev.ub"],
      "stdout": "want/validate.stdout",
      "stderr": "want/validate.stderr"
    },
    {
      "name": "validate-json",
      "args": ["validate", "-c", "stacks/dev.ub", "--format", "json"],
      "stdout": "want/validate-json.stdout",
      "normalize": "json"
    },
    {
      "name": "validate-unobin",
      "args": ["validate", "-c", "stacks/dev.ub", "--format", "unobin"],
      "stdout": "want/validate-unobin.stdout"
    },
    {
      "name": "schema-template",
      "args": ["schema", "template"],
      "stdout": "want/schema-template.stdout",
      "stderr": "want/schema-template.stderr"
    },
    {
      "name": "schema-template-payload-format",
      "args": ["schema", "template", "--format", "json"],
      "stderr": "want/payload-format.stderr",
      "exitCode": 1
    },
    {
      "name": "schema-show",
      "args": ["schema", "show"],
      "stdout": "want/schema-show.stdout",
      "stderr": "want/schema-show.stderr"
    },
    {
      "name": "schema-show-json",
      "args": ["schema", "show", "--format", "json"],
      "stdout": "want/schema-show-json.stdout",
      "normalize": "json"
    },
    {
      "name": "schema-show-unobin",
      "args": ["schema", "show", "--format", "unobin"],
      "stdout": "want/schema-show-unobin.stdout"
    },
    {
      "name": "print-graph",
      "args": ["print-graph"],
      "stdout": "want/print-graph.stdout",
      "stderr": "want/print-graph.stderr"
    },
    {
      "name": "print-graph-dot",
      "args": ["print-graph", "--format", "dot"],
      "stdout": "want/print-graph-dot.stdout",
      "stderr": "want/print-graph-dot.stderr"
    },
    {
      "name": "print-graph-json",
      "args": ["print-graph", "--format", "json"],
      "stdout": "want/print-graph-json.stdout",
      "normalize": "json"
    },
    {
      "name": "print-graph-unobin",
      "args": ["print-graph", "--format", "unobin"],
      "stdout": "want/print-graph-unobin.stdout"
    },
    {
      "name": "print-graph-unknown",
      "args": ["print-graph", "--format", "yaml"],
      "stderr": "want/print-graph-unknown.stderr",
      "exitCode": 1
    },
    {
      "name": "state-list-empty-json",
      "args": ["state", "list", "-c", "stacks/dev.ub", "--format", "json"],
      "stdout": "want/state-list-empty-json.stdout",
      "normalize": "json"
    },
    {
      "name": "state-snapshots-empty-json",
      "args": ["state", "snapshots", "list", "-c", "stacks/dev.ub", "--format", "json"],
      "stdout": "want/state-snapshots-empty-json.stdout",
      "normalize": "json"
    },
    {
      "name": "plan-json-no-output",
      "args": ["plan", "-c", "stacks/dev.ub", "--format", "json"],
      "stdout": "want/plan-json-no-output.stdout",
      "normalize": "json"
    },
    {
      "name": "plan-unobin-no-output",
      "args": ["plan", "-c", "stacks/dev.ub", "--format", "unobin"],
      "stdout": "want/plan-unobin-no-output.stdout"
    },
    {
      "name": "plan-json-write-failure",
      "args": ["plan", "-c", "stacks/dev.ub", "-o", ".", "--format", "json"],
      "stdout": "want/plan-json-write-failure.stdout",
      "normalize": "json",
      "exitCode": 1
    },
    {
      "name": "plan-create",
      "args": ["plan", "--ascii", "-c", "stacks/dev.ub", "-o", "plan.ubp"],
      "stdout": "want/plan-create.stdout",
      "stderr": "want/plan-create.stderr"
    },
    {
      "name": "plan-json-updated",
      "args": ["plan", "-c", "stacks/dev.ub", "-o", "plan.ubp", "--format", "json"],
      "stdout": "want/plan-json-updated.stdout",
      "normalize": "json"
    },
    {
      "name": "apply-create",
      "args": ["apply", "--output", "json", "plan.ubp"],
      "stdout": "want/apply-create.stdout",
      "normalize": "json"
    },
    {
      "name": "output-json",
      "args": ["output", "--format", "json", "-c", "stacks/dev.ub"],
      "stdout": "want/output.json",
      "normalize": "json"
    },
    {
      "name": "state-pull-payload-format",
      "args": ["state", "pull", "--format", "json"],
      "stderr": "want/payload-format.stderr",
      "exitCode": 1
    }
  ],
  "deterministic": true
}
