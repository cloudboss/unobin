      "stdout": "want/plan-delete-error-change.stdout",
      "stderr": "want/plan-delete-error-change.stderr"
    },
    {
      "name": "apply-delete-error-change",
      "args": ["apply", "--format", "json", "delete-error-change.ubp"],
      "stdout": "want/apply-delete-error-change.stdout",
      "normalize": "json",
      "env": {
        "E2E_FAIL_DELETE": "1"
