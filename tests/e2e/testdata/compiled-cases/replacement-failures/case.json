{
  "name": "replacement-failures",
  "factoryPath": "src",
  "libraryPath": "example.com/unobin/e2e/replacement-failures",
  "build": true,
  "commands": [
    {
      "name": "plan-changed-identity-create",
      "args": ["plan", "--ascii", "-c", "stacks/create/changed-identity.ub", "-o", "changed-identity-create.ubp"],
      "stdout": "want/plan-changed-identity-create.stdout",
      "stderr": "want/plan-changed-identity-create.stderr"
    },
    {
      "name": "apply-changed-identity-create",
      "args": ["apply", "--format", "json", "changed-identity-create.ubp"],
      "stdout": "want/apply-changed-identity-create.stdout",
      "normalize": "json"
    },
    {
      "name": "plan-changed-identity-change",
      "args": ["plan", "--ascii", "-c", "stacks/change/changed-identity.ub", "-o", "changed-identity-change.ubp"],
      "stdout": "want/plan-changed-identity-change.stdout",
      "stderr": "want/plan-changed-identity-change.stderr"
    },
    {
      "name": "apply-changed-identity-change",
      "args": ["apply", "--format", "json", "changed-identity-change.ubp"],
      "stdout": "want/apply-changed-identity-change.stdout",
      "normalize": "json",
      "env": {
        "E2E_REMOTE_ID": "external"
      },
      "exitCode": 1
    },
    {
      "name": "state-changed-identity",
      "args": ["state", "show", "resource.object", "-c", "stacks/change/changed-identity.ub", "--format", "json"],
      "stdout": "want/state-changed-identity.json",
      "normalize": "json"
    },
    {
      "name": "plan-delete-error-create",
      "args": ["plan", "--ascii", "-c", "stacks/create/delete-error.ub", "-o", "delete-error-create.ubp"],
