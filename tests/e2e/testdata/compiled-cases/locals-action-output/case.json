{
  "name": "locals-action-output",
  "factoryPath": "src",
  "libraryPath": "example.com/unobin/e2e/locals-action-output",
  "build": true,
  "commands": [
    {
      "name": "validate",
      "args": ["validate", "-c", "stacks/dev/dev.ub"],
      "stdout": "want/validate.stdout",
      "stderr": "want/validate.stderr"
    },
    {
      "name": "plan",
      "args": ["plan", "--ascii", "-c", "stacks/dev/dev.ub", "-o", "plan.ubp"],
      "stdout": "want/plan.stdout",
      "stderr": "want/plan.stderr"
    },
    {
      "name": "apply",
      "args": ["apply", "--format", "json", "plan.ubp"],
      "stdout": "want/apply.stdout",
      "normalize": "json"
    },
    {
      "name": "output",
      "args": ["output", "--format", "json", "-c", "stacks/dev/dev.ub"],
      "stdout": "want/output.json",
      "normalize": "json"
    }
  ],
  "deterministic": true
}
