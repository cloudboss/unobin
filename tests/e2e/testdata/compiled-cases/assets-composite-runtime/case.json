{
  "name": "assets-composite-runtime",
  "factoryPath": "src",
  "libraryPath": "example.com/unobin/e2e/assets-composite-runtime",
  "build": true,
  "emptyDirectories": [
    "src/library/zipdir/empty",
    "cache/plan",
    "cache/apply"
  ],
  "removeAfterCompile": ["src/library/zipdir"],
  "assetBundle": {
    "setCount": 1,
    "blobCount": 4
  },
  "assetCache": {
    "path": "cache/apply",
    "referenceCount": 4
  },
  "assetIdentity": {
    "asset": "zipdir",
    "stableEntry": "main.go",
    "changePath": "src/library/zipdir/internal/helpers.go",
    "replacementPath": "mutations/helpers.go"
  },
  "commands": [
    {
      "name": "plan",
      "args": [
        "--asset-cache-dir", "cache/plan",
        "plan", "--ascii", "--parallelism", "1",
        "-c", "stacks/dev.ub", "-o", "plan.ubp"
      ],
      "stdout": "want/plan.stdout",
      "stderr": "want/plan.stderr"
    },
    {
      "name": "apply",
      "args": [
        "--asset-cache-dir", "cache/apply",
        "apply", "--format", "json", "plan.ubp"
      ],
      "stdout": "want/apply.stdout",
      "normalize": "json"
    }
  ],
  "planSummaries": [
    {
      "path": "plan.ubp",
      "want": "want/plan-summary.json",
      "includeInputs": true
    }
  ],
  "fileExclusions": [
    {
      "path": "plan.ubp",
      "text": [
        "package main",
        "package internal",
        "$WORKSPACE",
        "cache/plan",
        "cache/apply"
      ]
    }
  ],
  "absentFiles": ["src/library/zipdir"],
  "stateSummary": "want/state-summary.json"
}
