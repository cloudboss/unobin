{
  "name": "sensitivity",
  "factoryPath": "src",
  "libraryPath": "example.com/unobin/e2e/sensitivity",
  "build": true,
  "commands": [
    {
      "name": "plan-json",
      "args": ["plan", "-c", "stacks/dev.ub", "-o", "sensitive.ubp", "--format", "json"],
      "stdout": "want/plan-json.stdout",
      "normalize": "json"
    },
    {
      "name": "plan",
      "args": ["plan", "--ascii", "-c", "stacks/dev.ub", "-o", "sensitive.ubp"],
      "stdout": "want/plan.stdout",
      "stderr": "want/plan.stderr"
    },
    {
      "name": "apply",
      "args": ["apply", "--format", "json", "sensitive.ubp"],
      "stdout": "want/apply.stdout",
      "normalize": "json"
    },
    {
      "name": "output-json",
      "args": ["output", "--format", "json", "-c", "stacks/dev.ub"],
      "stdout": "want/output.json",
      "normalize": "json"
    },
    {
      "name": "output-token-json",
      "args": [
        "output", "token", "--format", "json", "-c", "stacks/dev.ub"
      ],
      "stdout": "want/output-token-json.stdout",
      "normalize": "json"
    },
    {
      "name": "state-show-record",
      "args": ["state", "show", "-c", "stacks/dev.ub", "action.record"],
      "stdout": "want/state-show-record.stdout",
      "stderr": "want/state-show-record.stderr"
    },
    {
      "name": "state-show-secret",
      "args": ["state", "show", "-c", "stacks/dev.ub", "action.go-secret"],
      "stdout": "want/state-show-secret.stdout",
      "stderr": "want/state-show-secret.stderr"
    },
    {
      "name": "state-show-secret-json",
      "args": [
        "state", "show", "-c", "stacks/dev.ub", "action.go-secret", "--format", "json"
      ],
      "stdout": "want/state-show-secret-json.stdout",
      "normalize": "json"
    }
  ],
  "stateSummary": "want/state-summary.json",
  "deterministic": true
}
