resources: {
  upstream: core.plain {}
  conflict: core.thing {
    metadata: {
      name:          'storage'
      generate-name: 'storage-'
      labels:        { owner: resource.upstream.owner }
    }
    topologies: [{ zone: resource.upstream.zone }, { zone: 'fixed' }]
  }
  generated: core.thing {
    metadata:   { name: 'storage', labels: { owner: 'team' } }
    topologies: [ for zone in ['east', 'west'] : { zone: resource.upstream.zone } ]
  }
  deferred: core.thing {
    metadata: {
      name:          'storage'
      generate-name: resource.upstream.prefix
      labels:        { owner: resource.upstream.owner }
    }
    topologies: resource.upstream.topologies
  }
  valid: core.thing {
    metadata: {
      name:   'storage'
      labels: { owner: resource.upstream.owner }
    }
    topologies: [{ zone: resource.upstream.zone }]
  }
}
