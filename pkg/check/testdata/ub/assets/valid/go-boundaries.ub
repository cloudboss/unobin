factory: {
  assets: {
    tree:    './tree'
    archive: './archive.zip'
  }

  locals: {
    source-path:      asset.tree.path
    source-content:   asset.archive.content
    accepted-path:    native.accept-path(local.source-path)
    accepted-content: native.accept-content(local.source-content)
  }

  resources: {
    sink: native.sink {
      path:    local.source-path
      content: local.source-content
      nested: {
        paths: [
          asset.tree.path,
          asset.tree['internal'].path,
        ]
        content: asset.tree['main.go'].content
      }
    }
  }
}
