inputs: {
  subnet-set: { type: integer, default: 0 }
}

locals: {
  selected-subnet-ids: if input.subnet-set == 0
    then [resource.subnet-a.id]
    else [1 / 0]
}

resources: {
  subnet-a: core.thing { name: 'subnet-a', size: 1 }
  clear: core.pending-list {
    name:       'UNOBIN-IT-CACHE-CLEAR'
    subnet-ids: local.selected-subnet-ids
  }
}
