locals: {
  selection: if resource.selector.id == 'primary'
    then {
      ids:     [resource.subnet-a.id]
      ignored: [resource.subnet-c.id]
    }
    else {
      ids:     [resource.subnet-b.id]
      ignored: [resource.subnet-c.id]
  }
  selected-subnet-ids: local.selection.ids
  selected-subnet-ids-index: local.selection['ids']
}

resources: {
  selector: core.thing { name: 'selector', size: 1 }
  subnet-a: core.thing { name: 'subnet-a', size: 1 }
  subnet-b: core.thing { name: 'subnet-b', size: 1 }
  subnet-c: core.thing { name: 'subnet-c', size: 1 }
  clear: core.pending-list {
    name:       'UNOBIN-IT-CACHE-CLEAR'
    subnet-ids: local.selected-subnet-ids
  }
  clear-index: core.pending-list {
    name:       'UNOBIN-IT-CACHE-CLEAR-INDEX'
    subnet-ids: local.selected-subnet-ids-index
  }
}
