locals: {
  cases: {
    valid:          { data: { token: 'value' }, field-manager: 'test', force: false }
    list-data:      { data: ['value'],          field-manager: 'test', force: false }
    number-entry:   { data: { token: 42 },      field-manager: 'test', force: false }
    number-manager: { data: { token: 'value' }, field-manager: 42,     force: false }
    string-force:   { data: { token: 'value' }, field-manager: 'test', force: 'true' }
  }
  selection: if input.deferred then action.seed.value else input.selection
  selected: @core.lookup(local.cases, local.selection)
}
actions: {
  seed: core.seed { selection: input.selection }
}
resources: {
  example: core.secret {
    data:          local.selected.data
    field-manager: local.selected.field-manager
    force:         local.selected.force
  }
}
