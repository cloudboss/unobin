checks: {
  matches:           @core.matches('abc', '^a[a-z]+$')
  mismatch:          !@core.matches('123', '^[a-z]+$')
  partial-match:     @core.matches('abc', 'b')
  invalid-pattern:   !@core.matches('abc', '[')
  escaped-pattern:   @core.matches('a.b', '^a\\.b$')
  regex:             @core.is-regex('^[a-z]+$')
  invalid-regex:     !@core.is-regex('[')
  empty-regex:       @core.is-regex('')
  ipv4:              @core.is-ip('127.0.0.1')
  ipv6:              @core.is-ip('2001:db8::1')
  invalid-ip:        !@core.is-ip('999.1.1.1')
  zoned-ip:          !@core.is-ip('fe80::1%eth0')
  empty-ip:          !@core.is-ip('')
  cidr4:             @core.is-cidr('10.0.0.1/24')
  cidr6:             @core.is-cidr('2001:db8::/32')
  invalid-cidr:      !@core.is-cidr('10.0.0.1/33')
  ip-as-cidr:        !@core.is-cidr('10.0.0.1')
  base64:            @core.is-base64('aGk=')
  empty-base64:      @core.is-base64('')
  invalid-base64:    !@core.is-base64('!')
  unpadded-base64:   !@core.is-base64('aGk')
  duration:          @core.is-positive-duration('1h30m')
  negative-duration: !@core.is-positive-duration('-1s')
  zero-duration:     !@core.is-positive-duration('0s')
  invalid-duration:  !@core.is-positive-duration('1d')
  overflow-duration: !@core.is-positive-duration('999999999999999999999h')
  null-matches:      @core.matches(null, '^a$')
  null-regex:        @core.is-regex(null)
  null-ip:           @core.is-ip(null)
  null-cidr:         @core.is-cidr(null)
  null-base64:       @core.is-base64(null)
  null-duration:     @core.is-positive-duration(null)
}
