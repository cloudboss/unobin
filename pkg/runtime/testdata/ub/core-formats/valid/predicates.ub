checks: {
  matches:           @core.is-match('abc', '^a[a-z]+$')
  mismatch:          !@core.is-match('123', '^[a-z]+$')
  partial-match:     @core.is-match('abc', 'b')
  invalid-pattern:   !@core.is-match('abc', '[')
  escaped-pattern:   @core.is-match('a.b', '^a\\.b$')
  regex:             @core.is-format('^[a-z]+$', 'regex')
  invalid-regex:     !@core.is-format('[', 'regex')
  empty-regex:       @core.is-format('', 'regex')
  ipv4:              @core.is-format('127.0.0.1', 'ip')
  ipv6:              @core.is-format('2001:db8::1', 'ip')
  invalid-ip:        !@core.is-format('999.1.1.1', 'ip')
  zoned-ip:          !@core.is-format('fe80::1%eth0', 'ip')
  empty-ip:          !@core.is-format('', 'ip')
  cidr4:             @core.is-format('10.0.0.1/24', 'cidr')
  cidr6:             @core.is-format('2001:db8::/32', 'cidr')
  invalid-cidr:      !@core.is-format('10.0.0.1/33', 'cidr')
  ip-as-cidr:        !@core.is-format('10.0.0.1', 'cidr')
  base64:            @core.is-format('aGk=', 'base64')
  empty-base64:      @core.is-format('', 'base64')
  invalid-base64:    !@core.is-format('!', 'base64')
  unpadded-base64:   !@core.is-format('aGk', 'base64')
  duration:          @core.is-format('1h30m', 'positive-duration')
  negative-duration: !@core.is-format('-1s', 'positive-duration')
  zero-duration:     !@core.is-format('0s', 'positive-duration')
  invalid-duration:  !@core.is-format('1d', 'positive-duration')
  overflow-duration: !@core.is-format('999999999999999999999h', 'positive-duration')
  null-matches:      @core.is-match(null, '^a$')
  null-regex:        @core.is-format(null, 'regex')
  null-ip:           @core.is-format(null, 'ip')
  null-cidr:         @core.is-format(null, 'cidr')
  null-base64:       @core.is-format(null, 'base64')
  null-duration:     @core.is-format(null, 'positive-duration')
  leap-date: @core.is-format('2024-02-29T10:00:00Z', 'date-time')
  invalid-date: !@core.is-format('2025-02-29T10:00:00Z', 'date-time')
  json: @core.is-format('{"ok":true}', 'json')
  invalid-json: !@core.is-format('{', 'json')
  max-int64: @core.is-format('+0009223372036854775807', 'int64')
  min-int64: @core.is-format('-9223372036854775808', 'int64')
  overflow-int64: !@core.is-format('9223372036854775808', 'int64')
  underflow-int64: !@core.is-format('-9223372036854775809', 'int64')
  empty-int64: !@core.is-format('', 'int64')
  hex-int64: !@core.is-format('0x7f', 'int64')
}
