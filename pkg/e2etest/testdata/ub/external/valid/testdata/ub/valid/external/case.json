{
  "name": "external",
  "factoryPath": "src",
  "libraryPath": "example.com/generated/external",
  "build": true,
  "commands": [
    {
      "name": "plan",
      "args": ["plan", "--ascii", "-c", "stacks/dev.ub", "-o", "plan.ubp"],
      "stdout": "want/plan.stdout",
      "stderr": "want/notice.stderr"
    },
    {
      "name": "apply",
      "args": ["apply", "--format", "json", "plan.ubp"],
      "stdout": "want/apply.stdout",
      "normalize": "json"
    },
    {
      "name": "output",
      "args": ["output", "--format", "json", "-c", "stacks/dev.ub"],
      "stdout": "want/output.json",
      "normalize": "json"
    }
  ],
  "files": [{ "path": "result.txt", "want": "want/result.txt" }]
}
